# MEMBRA Runtime Environment Schema

# Core
APP_ENV=local
APP_NAME=MEMBRA
APP_VERSION=0.1.0
APP_DB_PATH=membra.db
APP_UPLOAD_DIR=membra_uploads
APP_EXPORT_DIR=exports

# Auth
AUTH_ENABLED=false
AUTH_ISSUER_URL=
AUTH_AUDIENCE=
AUTH_JWKS_URL=

# Tenant
DEFAULT_TENANT_ID=local-default

# Groq
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_TEXT_MODEL=llama-3.1-8b-instant
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
OLLAMA_VISION_MODEL=llava

# Runtime provider policy
LLM_PROVIDER=auto
OCR_PROVIDER=deterministic
VISION_PROVIDER=auto

# Object storage
OBJECT_STORAGE_PROVIDER=local
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_REGION=
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=

# Queue
QUEUE_PROVIDER=local
REDIS_URL=

# Billing
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=

# Observability
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
METRICS_ENABLED=true

# Runtime safety
ALLOW_PAYOUT_EXECUTION=false
ALLOW_CHAIN_EXECUTION=false
DRY_RUN_EXTERNAL_EXECUTION=true
