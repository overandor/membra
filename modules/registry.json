{
  "membra_os_version": "1.0.0",
  "doctrine": "One MEMBRA operating system, many specialized modules. Replit develops against this registry as the source of truth.",
  "production_boundary": "MEMBRA records proof, listings, reports, and payout eligibility. MEMBRA does not custody funds. External rails settle money.",
  "modules": [
    {
      "id": "membra-root",
      "repo": "https://github.com/overandor/membra",
      "role": "Umbrella website, command center, repo registry, doctrine, and Replit orchestration hub",
      "type": "os_hub",
      "priority": 1,
      "local_path": "modules/membra",
      "default_port": 8000,
      "health_path": "/api/health",
      "replit_style": "orchestrator"
    },
    {
      "id": "membra-kpi",
      "repo": "https://github.com/overandor/Membra_kpi",
      "role": "Main production wedge: photo/data upload to inventory, SKU, KPI, ProofBook, draft listings, marketplace, wallet eligibility",
      "type": "product_app",
      "priority": 2,
      "local_path": "modules/Membra_kpi",
      "default_port": 8001,
      "health_path": "/api/health",
      "replit_style": "primary_deployable"
    },
    {
      "id": "membra-api",
      "repo": "https://github.com/overandor/Membra_api",
