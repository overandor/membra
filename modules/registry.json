      "priority": 4,
      "local_path": "modules/Membra_proofbook",
      "default_port": 8003,
      "health_path": "/api/health",
      "replit_style": "service"
    },
    {
      "id": "membra-wallet",
      "repo": "https://github.com/overandor/Membra_wallet",
