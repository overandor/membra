# MEMBRA Environment Variables

# HuggingFace Token (for deployment)
HF_TOKEN=

# MEMBRA Devnet Doctrine Configuration
MEMBRA_ENV=devnet
SOLANA_CLUSTER=devnet
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_COMMITMENT=confirmed
ALLOW_MAINNET=false
ALLOW_REAL_FUNDS=false
ALLOW_LIVE_TRADING=false
DRY_RUN=true
DATABASE_URL=sqlite:///membra_devnet.db
PROOFBOOK_ANCHOR_ON_DEVNET=true
DEVNET_AIRDROP_ENABLED=true
DEVNET_AIRDROP_SOL=1
AGENT_FEE_PAYER_MODE=platform
PLATFORM_DEVNET_FEE_PAYER_SECRET=
GRADUATION_MIN_SKILL_TESTS=5
GRADUATION_MIN_AVG_SCORE=0.80
GRADUATION_MIN_TASK_SIMULATIONS=3
GRADUATION_MIN_PROOF_ANCHORS=3
GRADUATION_MIN_SIMULATED_PROFIT_USD=100
MAINNET_PROMOTION_REQUIRES_HUMAN_APPROVAL=true

# Optional: API Keys for future features
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
